+def run_git(command, probe=False):
+    """Retry network operations and propagate errors instead of leaving empty repos."""
+    attempts = 3 if any(arg in ('clone', 'fetch') for arg in command[1:]) else 1
+    for attempt in range(attempts):
+        proc = subprocess.run(command, capture_output=True)
+        if proc.returncode == 0 or probe:
+            return proc
+        if attempt + 1 < attempts:
+            print(proc.stderr.decode(errors='replace'), file=sys.stderr)
+            time.sleep(2 ** attempt)
+    print(proc.stderr.decode(errors='replace'), file=sys.stderr)
+    proc.check_returncode()
 
 

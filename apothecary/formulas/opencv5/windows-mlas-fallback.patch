 set(OPENCV_DNN_MLAS_ENABLED     0  CACHE INTERNAL "" FORCE)
 set(OPENCV_DNN_MLAS_SKIP_REASON "" CACHE INTERNAL "" FORCE)
 
+# Vendored MLAS uses GNU assembly and POSIX allocation APIs unavailable
+# across the supported Windows toolchains; retain the built-in DNN kernels.
+if(WIN32)
+  set(OPENCV_DNN_MLAS_SKIP_REASON "vendored MLAS kernels unsupported on Windows"
+      CACHE INTERNAL "" FORCE)
+  message(STATUS "MLAS disabled on Windows; DNN will use its built-in SGEMM")
+  return()
+endif()

+    set(_OQS_SHA3_SYMBOL_RENAMES
+        keccak_1600_init_state=OQS_keccak_1600_init_state
+        keccak_1600_load_state_x4=OQS_keccak_1600_load_state_x4
+        keccak_1600_save_state_x4=OQS_keccak_1600_save_state_x4
+        keccak_1600_partial_add_x4=OQS_keccak_1600_partial_add_x4
+        keccak_1600_extract_bytes_x4=OQS_keccak_1600_extract_bytes_x4
+        SHA3_shake128_x4_avx512vl=OQS_SHA3_shake128_x4_avx512vl
+        SHA3_shake128_x4_inc_absorb_avx512vl=OQS_SHA3_shake128_x4_inc_absorb_avx512vl
+        SHA3_shake128_x4_inc_finalize_avx512vl=OQS_SHA3_shake128_x4_inc_finalize_avx512vl
+        SHA3_shake128_x4_inc_squeeze_avx512vl=OQS_SHA3_shake128_x4_inc_squeeze_avx512vl
+        SHA3_shake256_x4_avx512vl=OQS_SHA3_shake256_x4_avx512vl

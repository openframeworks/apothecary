+        assert(angle_xros_clang_runtime_dir != "",
+               "visionOS requires the selected Xcode's Clang runtime directory")
+        _clang_lib_dir = get_path_info(angle_xros_clang_runtime_dir, "dir")
+      }
       _lib_file = "${_prefix}clang_rt.${_libname}${_suffix}.${_ext}"
       libs = [ "$_clang_lib_dir/$_dir/$_lib_file" ]
     }
   }

# Relocatable configuration for the Apothecary staging layout.
if(TARGET apothecary::rgfw)
    return()
endif()
get_filename_component(_rgfw_prefix "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
find_library(_rgfw_library NAMES rgfw PATHS "${CMAKE_CURRENT_LIST_DIR}/.." NO_DEFAULT_PATH REQUIRED)
add_library(apothecary::rgfw STATIC IMPORTED)
set_target_properties(apothecary::rgfw PROPERTIES IMPORTED_LOCATION "${_rgfw_library}"
    INTERFACE_INCLUDE_DIRECTORIES "${_rgfw_prefix}/include" INTERFACE_COMPILE_DEFINITIONS "RGFW_OPENGL;RGFWDEF=extern")
if(EMSCRIPTEN)
elseif(WIN32)
    set_property(TARGET apothecary::rgfw PROPERTY INTERFACE_LINK_LIBRARIES opengl32 gdi32 user32 shell32)
elseif(APPLE)
    set_property(TARGET apothecary::rgfw PROPERTY INTERFACE_LINK_LIBRARIES "-framework Cocoa;-framework OpenGL;-framework IOKit;-framework CoreVideo")
else()
    include(CMakeFindDependencyMacro)
    find_dependency(X11 COMPONENTS Xrandr Xcursor Xi Xext)
    find_dependency(OpenGL)
    find_dependency(Threads)
    set_property(TARGET apothecary::rgfw PROPERTY INTERFACE_LINK_LIBRARIES "X11::X11;X11::Xrandr;X11::Xcursor;X11::Xi;X11::Xext;OpenGL::GL;Threads::Threads;${CMAKE_DL_LIBS};m")
endif()
